# ═══════════════════════════════════════════════════════════════
# قالب متغيّرات البيئة — انسخه إلى .env واملأ القيم الحقيقية
#   cp .env.example .env
# ملف .env مستثنى من Git (لا يُرفع أبداً). عند النشر على منصة
# (Netlify / Render / Railway) أضِف نفس المتغيّرات في لوحة المنصة.
# ═══════════════════════════════════════════════════════════════

# ── إعدادات Firebase العامة (تُحقن في الواجهة) ──
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ── حساب اللوحة (سرّي — يبقى على الخادم فقط) ──
FIREBASE_PANEL_EMAIL=
FIREBASE_PANEL_PASSWORD=

# ── نطاق الموقع العام (اختياري) ──
# يُستخدم في الروابط المطلقة (og:image/canonical/sitemap). الخادم الديناميكي
# يستخدم نطاق الطلب الفعلي تلقائياً؛ اضبطه للاستضافة الثابتة (Netlify) أو
# لتثبيت نطاق مخصّص. مثال: https://althenayanfarms.app
SITE_URL=

# ── سياسة كاش صفحات موقع العملاء (اختياري) ──
# تتحكم بترويسة Cache-Control لصفحات HTML (index/cart/product/prices).
#   غير مضبوط  → no-cache, must-revalidate  (أحدث نسخة + توفير النطاق)
#   no-store   → لا يُحفظ الكاش إطلاقاً (كل فتح = جلب جديد من الخادم)
# ملاحظة: لوحة التحكم تبقى دائماً no-store بغضّ النظر عن القيمة.
# SITE_CACHE_CONTROL=no-store, no-cache, must-revalidate, max-age=0
SITE_CACHE_CONTROL=
